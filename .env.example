# Shared demo settings. Copy to .env and keep real values out of Git.
DEMO_MODE=true
SEED_DEMO=true
DATABASE_URL=sqlite:///../../data/opsledger.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Local agent provider. No model API key is required for codex_luna.
MODEL_PROVIDER=codex_luna
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=xhigh
CODEX_TIMEOUT_SECONDS=120
CODEX_BINARY=
MODEL_STRICT=false
DEMO_POLICY_AS_OF_DATE=2026-08-13

# Upload and storage controls.
MAX_UPLOAD_MB=8
MAX_PDF_PAGES=50
MAX_TABLE_ROWS=10000
LOCAL_DATA_DIR=../../data
STORAGE_BACKEND=local
STORAGE_BUCKET=opsledger-demo
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Production-only controls.
POSTGRES_PASSWORD=
SESSION_SECRET=
REVIEWER_TOKEN=
LOG_LEVEL=INFO
